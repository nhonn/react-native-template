{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-hooks"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-explicit-any": "off"
  },
  "ignorePatterns": [".agents/**"],
  "env": {
    "builtin": true
  }
}
