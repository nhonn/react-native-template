{
  "name": "my-template-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "verify:locales": "bun ./scripts/verify-locales.mjs",
    "prebuild": "bunx expo prebuild --clean",
    "prebuild:dev": "APP_VARIANT=development bunx expo prebuild --clean",
    "format": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true"
  },
  "dependencies": {
    "@expo/material-symbols": "0.1.1",
    "@expo/ui": "58.0.12",
    "@legendapp/list": "3.6.0",
    "@legendapp/state": "2.1.15",
    "@react-navigation/native": "7.5.0",
    "@rnrepo/expo-config-plugin": "0.3.6",
    "@sentry/react-native": "8.28.0",
    "dayjs": "1.11.23",
    "expo": "58.0.3",
    "expo-application": "58.0.3",
    "expo-build-properties": "58.0.10",
    "expo-constants": "58.0.9",
    "expo-crypto": "58.0.4",
    "expo-dev-client": "58.0.11",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.5",
    "expo-image": "58.0.11",
    "expo-linking": "58.0.10",
    "expo-localization": "58.0.3",
    "expo-router": "58.0.16",
    "expo-splash-screen": "58.0.5",
    "expo-status-bar": "58.0.3",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.15",
    "react-native": "0.88.0-rc.3",
    "react-native-gesture-handler": "3.3.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-nitro-web-image": "0.15.2",
    "react-native-purchases": "10.11.0",
    "react-native-purchases-ui": "10.11.0",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.28.0",
    "react-native-skia": "3.0.3",
    "react-native-unistyles": "3.5.0",
    "react-native-worklets": "0.13.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@expo/metro-runtime": "58.0.11",
    "@types/react": "19.3.0",
    "babel-plugin-inline-import": "3.0.0",
    "lefthook": "2.1.16",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.4.2",
      "onFail": "ignore"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "trustedDependencies": [
    "@sentry/cli",
    "lefthook"
  ]
}
