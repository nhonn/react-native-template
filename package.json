{
  "name": "my-template-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "clean": "bun ./scripts/clean.mjs",
    "codegen": "bun ./scripts/codegen.mjs",
    "lint": "oxlint .",
    "format": "bun fmt",
    "typecheck": "bun check",
    "verify:locales": "bun ./scripts/verify-locales.mjs",
    "prebuild": "bunx expo prebuild --clean",
    "prebuild:dev": "APP_VARIANT=development bunx expo prebuild --clean",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true"
  },
  "dependencies": {
    "@expo/ui": "~58.0.25",
    "@legendapp/list": "3.7.0",
    "@legendapp/state": "3.0.0-beta.48",
    "@sentry/react-native": "^8.33.0",
    "dayjs": "1.11.23",
    "expo": "~58.0.21",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "i18next": "26.5.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.1.9",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nano-icons": "^1.0.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-purchases": "11.0.0",
    "react-native-purchases-ui": "11.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-skia": "^3.7.0",
    "react-native-teleport": "1.2.3",
    "react-native-unistyles": "3.7.0",
    "react-native-watermelondb": "^0.1.5",
    "react-native-worklets": "0.13.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@types/react": "19.3.0",
    "lefthook": "2.2.2",
    "nitrogen": "0.37.1",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "trustedDependencies": [
    "@sentry/cli",
    "lefthook"
  ]
}
