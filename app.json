{
  "expo": {
    "name": "my-template-app",
    "slug": "my-template-project",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mytemplateproject",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mytemplateproject",
      "buildNumber": "1",
      "infoPlist": {}
    },
    "android": {
      "package": "com.mytemplateproject",
      "versionCode": 1,
      "version": "1.0.0"
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen"],
      "expo-image",
      "react-native-adapty",
      "expo-status-bar",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
